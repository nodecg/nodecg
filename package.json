{
  "name": "nodecg-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nodecg/nodecg.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "workspaces/internal-util",
    "workspaces/database-adapter-types",
    "workspaces/database-adapter-sqlite-legacy",
    "workspaces/cli",
    "workspaces/nodecg"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "run-p watch typecheck-watch",
    "watch": "tsdown --watch --no-clean",
    "typecheck-watch": "npm run typecheck -- --watch --preserveWatchOutput",
    "build": "tsdown",
    "typecheck": "tsc -b tsconfig.typecheck.json",
    "test": "vitest",
    "typetest": "npm -w nodecg run typetest",
    "lint": "eslint && prettier --check .",
    "fix": "eslint --fix && prettier --write ."
  },
  "prettier": {},
  "dependencies": {
    "nodecg": "workspace:*"
  },
  "devDependencies": {
    "@effect/cli": "^0.72.1",
    "@effect/language-service": "^0.55.5",
    "@effect/platform": "^0.93.0",
    "@effect/platform-node": "^0.100.0",
    "@eslint/js": "^9.39.0",
    "@vitest/coverage-v8": "^4.0.12",
    "effect": "^3.19.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "tsdown": "^0.16.6",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.12"
  },
  "nodecgRoot": true,
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "@vaadin/vaadin-usage-statistics": true,
    "esbuild": true,
    "msgpackr-extract@3.0.3": true,
    "puppeteer@25.1.0": true,
    "better-sqlite3": true
  }
}
